backend_anishidra/*$py.class
backend_anishidra/.pytest_cache/
backend_anishidra/.mypy_cache/

# Virtual Environments
backend_anishidra/.venv/
backend_anishidra/venv/
backend_anishidra/env/

# Static & Media Uploads
backend_anishidra/media/
backend_anishidra/staticfiles/

# Logs
backend_anishidra/logs/
backend_anishidra/*.log


# ==========================================
# React Front-End (frontend_anishidra)
# ==========================================
