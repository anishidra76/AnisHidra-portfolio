frontend_anishidra/dist/
frontend_anishidra/dist-ssr/
frontend_anishidra/build/
frontend_anishidra/.vite/
frontend_anishidra/.eslintcache
frontend_anishidra/*.local

# Logs
frontend_anishidra/npm-debug.log*
frontend_anishidra/yarn-debug.log*
frontend_anishidra/yarn-error.log*
frontend_anishidra/pnpm-debug.log*

# Specific Hidden Files
